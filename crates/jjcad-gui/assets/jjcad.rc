// Windows-Ressourcen der Anwendung: Symbol und Versionsangaben.
// Wird nur unter Windows eingebettet (siehe build.rs); die Zahlen sind
// bewusst ASCII, damit die .rc-Datei unabhaengig von der Codepage bleibt.

1 ICON "jjc-icon.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704b0"
    BEGIN
      VALUE "CompanyName", "Joschua Jaenicke"
      VALUE "FileDescription", "JoJa-CAD - 2D-CAD fuer Architektur und Bauantragszeichnungen"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "jjcad"
      VALUE "LegalCopyright", "Copyright (c) 2026 Joschua Jaenicke"
      VALUE "OriginalFilename", "jjcad.exe"
      VALUE "ProductName", "JoJa-CAD"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x407, 1200
  END
END
